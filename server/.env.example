# Settings for running the admin backend on your own computer.
# Copy this file to server/.env and change the two lines marked "change me".
# Never commit server/.env: it holds your login details. It is already in .gitignore.

# Where the admin listens. 127.0.0.1 means "this computer only", so Windows shows no firewall prompt.
HOST=127.0.0.1
PORT=4324

# Your first admin login (change me). Read ONCE, when the database has no admin yet.
# The first login makes you choose a new password. After that these two lines are ignored and can be deleted.
# The password must be 12 to 128 characters and must not be your email address.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-twelve-plus-characters

# Signs the login cookie. On your computer the example value below is accepted with a warning.
# Online it must be replaced: at least 32 characters, see "Put it online" in server/README.md for the command
# that prints 64 random hex characters.
SESSION_SECRET=replace-with-64-hex-characters-from-the-readme

# Optional settings. Remove the leading # to use one. Each is explained in server/README.md.

# "production" requires a real SESSION_SECRET and sends Secure cookies. Leave unset on your computer.
# NODE_ENV=production

# Where the database file lives. A relative path is resolved against the server/ folder.
# DATABASE_PATH=./data/archonx.sqlite

# The committed content defaults the database is seeded from and every stored version is merged over.
# CONTENT_DEFAULTS_PATH=../content/site-content.json

# Set to 1 only when a hosting proxy sits in front (Fly.io, Render). The Dockerfile already sets it.
# TRUST_PROXY=1

# The public address of the admin (scheme and host only) when it differs from the Host header.
# ADMIN_ORIGIN=https://admin.example.com

# Send every new lead to this https address as JSON (for example a Make or Zapier catch hook that emails you).
# LEAD_WEBHOOK_URL=https://hook.example.com/catch/abc

# When set, each webhook POST carries X-AX-Signature: sha256=<HMAC-SHA256 of the body> so the receiver can check it.
# LEAD_WEBHOOK_SECRET=

# Key for hashing visitor IP addresses. When unset it is derived from SESSION_SECRET.
# IP_HASH_SECRET=

# Forgotten password: set to 1 together with ADMIN_EMAIL and a new ADMIN_PASSWORD, start once, then remove it.
# ADMIN_PASSWORD_RESET=1
